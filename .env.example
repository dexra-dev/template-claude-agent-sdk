# Claude API key for the agent. Get one at https://platform.claude.com
ANTHROPIC_API_KEY=
# Model for the agent. claude-opus-5-5 is the stronger option, at a higher price.
ANTHROPIC_MODEL=claude-sonnet-5-5

# Dexra key (dxr_...). Without it free tools work and paid checks answer 402, which blocks every buy.
DEXRA_API_KEY=
# Point it at a local Dexra API for testing.
DEXRA_BASE_URL=https://api.dexra.dev
# Also connect Dexra's remote MCP server for read-only checks. Set to false to use only the trader tools.
DEXRA_MCP=true
# Remote MCP endpoint. Defaults to DEXRA_BASE_URL + /mcp.
DEXRA_MCP_URL=

# Jupiter key, sent as x-api-key. Adds quotes in a dry run; needed for live trading.
JUPITER_API_KEY=
# Base58 64-byte secret key. Only needed for live trading. Use a dedicated low-balance wallet.
SOLANA_PRIVATE_KEY=
# Live trading needs DRY_RUN=false AND SOLANA_PRIVATE_KEY AND JUPITER_API_KEY. Each live trade asks you first.
DRY_RUN=true
# Hard cap per buy, in SOL. A larger buy is refused, not reduced.
MAX_TRADE_SOL=0.05
# Slippage sent to Jupiter, whole number from 0 to 1000.
SLIPPAGE_BPS=100
# When true, a caution verdict passes the guard.
ALLOW_CAUTION=false
